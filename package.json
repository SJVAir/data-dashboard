{
	"name": "@sjvair/data-dashboard",
	"description": "SJVAir's data exploration dashboard",
	"version": "0.1.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/SJVAir/data-dashboard"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"build": "npm run paraglide && vite build",
		"preview": "vite preview",
		"check": "npm run paraglide && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run paraglide && vitest run",
		"test:unit": "npm run paraglide && vitest run --project unit",
		"test:browser": "npm run paraglide && vitest run --project browser",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:all": "playwright test",
		"test:e2e:podman": "bash scripts/e2e-podman.sh",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.5.1",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@lucide/svelte": "^1.46.0",
		"@sjvair/sdk": "npm:@jsr/sjvair__sdk@^4.5.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"color2k": "^2.0.4",
		"date-fns": "^4.4.0",
		"idb": "^8.0.4",
		"sv-router": "^0.19.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.7"
	}
}
